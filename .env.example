# SSMC EMR — Environment Configuration Template
# Copy this file to `.env` and fill in real values. Nothing in this file is
# a real secret — every value below is a placeholder.

# ==================== Database ====================
# Local PostgreSQL. DATABASE_URL and DIRECT_URL point at the same instance
# unless this is ever moved to a managed pooler (e.g. Supabase) — see
# CLAUDE.md's Database Connection Requirements note if that ever applies.
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/ssmc_emr?connection_limit=10&pool_timeout=20"
DIRECT_URL="postgresql://postgres:yourpassword@localhost:5432/ssmc_emr"

# ==================== Auth ====================
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRY="8h"
BCRYPT_ROUNDS=12
VERIFICATION_TOKEN_SECRET="replace-with-a-long-random-secret"

# ==================== Application ====================
NODE_ENV="development"
PORT=3000
DEFAULT_TENANT_ID="clinic-001"

# ==================== TLS (optional) ====================
# Set both to serve HTTPS instead of plain HTTP. Required for LAN
# deployments — see CLAUDE.md's "TLS / HTTPS" section. Leave unset for
# local dev over plain HTTP.
# TLS_CERT_PATH="certs/server.crt"
# TLS_KEY_PATH="certs/server.key"

# ==================== CORS (optional) ====================
# Comma-separated allowlist of origins allowed to call the API. Leave unset
# to reflect any origin (fine for local dev, not for production).
# CORS_ORIGIN="https://192.168.1.x:5173,https://your-clinic-hostname:5173"

# ==================== Rate limiting ====================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ==================== Payment gateways ====================
# Only the gateways an actual clinic uses need real values — unused ones
# can stay as placeholders.
FLUTTERWAVE_PUBLIC_KEY="your_public_key"
FLUTTERWAVE_SECRET_KEY="your_secret_key"
FLUTTERWAVE_ENCRYPTION_KEY="your_encryption_key"
FLUTTERWAVE_WEBHOOK_SECRET="your_webhook_secret"
MONIEPOINT_PUBLIC_KEY="your_public_key"
MONIEPOINT_SECRET_KEY="your_secret_key"
MONIEPOINT_WEBHOOK_SECRET="your_webhook_secret"
PAYSTACK_PUBLIC_KEY="your_public_key"
PAYSTACK_SECRET_KEY="your_secret_key"
PAYSTACK_WEBHOOK_SECRET="your_webhook_secret"

# ==================== Email / SMS providers (optional) ====================
EMAIL_PROVIDER="sendgrid"
SENDGRID_API_KEY="your_sendgrid_api_key"
SENDGRID_FROM_EMAIL="noreply@yourclinic.com"
SMS_PROVIDER="termii"
TERMII_API_KEY="your_termii_api_key"
TERMII_SENDER_ID="YourClinic"

# ==================== Error tracking (optional) ====================
SENTRY_DSN="https://yourkey@sentry.io/yourproject"
VITE_SENTRY_DSN="https://yourkey@sentry.io/yourproject"

# ==================== Offline sync ====================
SYNC_INTERVAL_MS=900000
SYNC_BATCH_SIZE=50
SYNC_RETRY_ATTEMPTS=3

# ==================== Legacy / unused ====================
# SQLCIPHER_KEY was for the deprecated Electron/local-SQLite path — see
# CLAUDE.md's Known Issues. Not used by the current web-only architecture.
# SQLCIPHER_KEY="unused"
