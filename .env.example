# SSMC EMR — Environment Configuration Template
# Copy this file to `.env` and fill in real values. Nothing in this file is
# a real secret — every value below is a placeholder.

# ==================== Database ====================
# Local PostgreSQL. DATABASE_URL and DIRECT_URL point at the same instance
# unless this is ever moved to a managed pooler (e.g. Supabase) — see
# CLAUDE.md's Database Connection Requirements note if that ever applies.
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/ssmc_emr?connection_limit=10&pool_timeout=20"
DIRECT_URL="postgresql://postgres:yourpassword@localhost:5432/ssmc_emr"

# ==================== Auth ====================
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRY="8h"
BCRYPT_ROUNDS=12
VERIFICATION_TOKEN_SECRET="replace-with-a-long-random-secret"

# ==================== Application ====================
NODE_ENV="development"
PORT=3000
DEFAULT_TENANT_ID="clinic-001"

# ==================== TLS (optional) ====================
# Set both to serve HTTPS instead of plain HTTP. Required for LAN
# deployments — see CLAUDE.md's "TLS / HTTPS" section. Leave unset for
# local dev over plain HTTP.
# TLS_CERT_PATH="certs/server.crt"
# TLS_KEY_PATH="certs/server.key"

# ==================== CORS (optional) ====================
# Comma-separated allowlist of origins allowed to call the API. Leave unset
# to reflect any origin (fine for local dev, not for production).
# CORS_ORIGIN="https://192.168.1.x:5173,https://your-clinic-hostname:5173"

# ==================== Rate limiting ====================
# General ceiling for ordinary clinical usage across the clinic LAN — not a
# defense against credential attacks; auth.routes.ts has its own dedicated,
# much stricter limiter (20 req/15min) scoped only to login/forgot-password/
# reset-password for that.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=400

# ==================== Payment gateways ====================
# Only the gateways an actual clinic uses need real values — unused ones
# can stay as placeholders.
FLUTTERWAVE_PUBLIC_KEY="your_public_key"
FLUTTERWAVE_SECRET_KEY="your_secret_key"
FLUTTERWAVE_ENCRYPTION_KEY="your_encryption_key"
FLUTTERWAVE_WEBHOOK_SECRET="your_webhook_secret"
MONIEPOINT_PUBLIC_KEY="your_public_key"
MONIEPOINT_SECRET_KEY="your_secret_key"
MONIEPOINT_WEBHOOK_SECRET="your_webhook_secret"
PAYSTACK_PUBLIC_KEY="your_public_key"
PAYSTACK_SECRET_KEY="your_secret_key"
PAYSTACK_WEBHOOK_SECRET="your_webhook_secret"

# ==================== Email / SMS providers (optional) ====================
EMAIL_PROVIDER="sendgrid"
SENDGRID_API_KEY="your_sendgrid_api_key"
SENDGRID_FROM_EMAIL="noreply@yourclinic.com"
SMS_PROVIDER="termii"
TERMII_API_KEY="your_termii_api_key"
TERMII_SENDER_ID="YourClinic"

# ==================== Error tracking (optional) ====================
SENTRY_DSN="https://yourkey@sentry.io/yourproject"
VITE_SENTRY_DSN="https://yourkey@sentry.io/yourproject"

# ==================== Offline sync ====================
SYNC_INTERVAL_MS=900000
SYNC_BATCH_SIZE=50
SYNC_RETRY_ATTEMPTS=3

# ==================== DHIS2 integration (optional) ====================
# Encrypts Tenant.dhis2Password at rest — see
# infrastructure/security/encryption.util.ts. Required only if any tenant
# enables DHIS2 sync. Generate once via:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this after a DHIS2 password is saved makes it undecryptable —
# the DHIS2 password would need re-entering in Settings.
# ENCRYPTION_KEY="replace-with-a-generated-32-byte-hex-value"
# The DHIS2 base URL/username/password, org unit, and data-element mapping
# are configured per tenant in Settings, not here — this key is the only
# DHIS2-related thing that belongs in environment config.

# ==================== Off-site database backup (optional) ====================
# Configure Backblaze B2, Google Drive, both, or neither — scripts/backup-database.js
# tries whichever of these two are actually configured, independently. If none are
# set, the local nightly backup still runs as before and just logs that the
# off-site step was skipped — this is not a hard dependency of the existing
# backup job. See CLAUDE.md's "Database Backups" section for one-time setup
# of either provider.
# BACKUP_ENCRYPTION_PASSPHRASE="replace-with-a-long-random-passphrase"
#
# -- Backblaze B2 --
# B2_BUCKET="ssmc-emr-backups"
# B2_APPLICATION_KEY_ID="your_b2_key_id"
# B2_APPLICATION_KEY="your_b2_application_key"
#
# -- Google Drive -- requires a dedicated OAuth client (Google Cloud Console ->
# APIs & Services -> Credentials -> OAuth client ID, type "Desktop app") —
# rclone's shared default client_id is being retired during 2026 (it prints
# an explicit warning to this effect), so this isn't optional in practice.
# See CLAUDE.md "Database Backups" for the full one-time setup.
# GDRIVE_CLIENT_ID="your_client_id.apps.googleusercontent.com"
# GDRIVE_CLIENT_SECRET="your_client_secret"
# The JSON blob printed by `rclone authorize "drive" "$GDRIVE_CLIENT_ID" "$GDRIVE_CLIENT_SECRET"`
# — this can't be generated without a one-time interactive browser login, and
# must be authorized with the client above (a token from one client can't be
# refreshed under a different one).
# GDRIVE_RCLONE_TOKEN='{"access_token":"...","token_type":"Bearer","refresh_token":"...","expiry":"..."}'
# GDRIVE_FOLDER_ID="your_drive_folder_id"

# ==================== Legacy / unused ====================
# SQLCIPHER_KEY was for the deprecated Electron/local-SQLite path — see
# CLAUDE.md's Known Issues. Not used by the current web-only architecture.
# SQLCIPHER_KEY="unused"
