// Note: This schema uses SQLite which has some limitations:
// - Enums are stored as String fields (values should be validated in application)
// - Arrays are stored as comma-separated strings
// - JSON is stored as TEXT but Prisma handles serialization
//
// SSMC EMR - Prisma Schema
// PostgreSQL database

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pg_trgm]
}

// ==================== PHASE 2 ENUMS ====================
enum TriageCategory {
  RESUSCITATION
  EMERGENT
  URGENT
  SEMI_URGENT
  NON_URGENT
  EMERGENCY
  PRIORITY
  QUEUE
  DEAD
}

enum InsuranceProviderType {
  NHIA
  HMO
  PRIVATE
}

enum InsurancePlanType {
  STANDARD
  COMPREHENSIVE
  PREMIUM
}

enum ClaimStatus {
  DRAFT
  SUBMITTED
  APPROVED
  DENIED
  PARTIALLY_APPROVED
  APPEALED
}

enum ExemptionCriteriaType {
  AGE
  CONDITION
  CUSTOM
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  UNKNOWN
}

enum Genotype {
  AA
  AS
  SS
  AC
  SC
  CC
  UNKNOWN
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  SEPARATED
  OTHER
}

enum PatientType {
  PRIVATE
  HMO
}

enum DiagnosisCertainty {
  CONFIRMED
  PROVISIONAL
  DIFFERENTIAL
  RULED_OUT
}

// ==================== MULTI-TENANCY ====================

model Tenant {
  id     String       @id @default(uuid())
  name   String
  slug   String       @unique
  status TenantStatus @default(ACTIVE)

  // Clinic Information
  clinicName    String
  address       String?
  phone         String?
  email         String?
  licenseNumber String?

  // Subscription
  subscriptionTier  String    @default("BASIC")
  subscriptionStart DateTime  @default(now())
  subscriptionEnd   DateTime?

  // Branding & Customization
  logoUrl        String? // URL to clinic logo
  primaryColor   String  @default("#3b82f6") // Blue
  secondaryColor String  @default("#10b981") // Green
  accentColor    String  @default("#f59e0b") // Amber
  fontFamily     String  @default("Inter")

  // Billing Configuration
  currency       String  @default("USD")
  currencySymbol String  @default("$")
  taxEnabled     Boolean @default(true)
  defaultTaxRate Decimal @default(0) // Percentage (e.g., 7.50%)
  taxName        String  @default("VAT")
  taxId          String? // Tax identification number

  // Pharmacy Pricing
  defaultMarkupPercent Decimal @default(40) // Percentage applied to unit cost to suggest a selling price for medication/consumable batches (e.g., 40.00%)

  // Payment Methods
  acceptCash         Boolean @default(true)
  acceptCard         Boolean @default(true)
  acceptMobileMoney  Boolean @default(true)
  acceptBankTransfer Boolean @default(true)
  acceptInsurance    Boolean @default(false)

  // Invoice Settings
  invoicePrefix      String  @default("INV")
  invoiceStartNumber Int     @default(1000)
  invoiceFooterText  String?
  termsAndConditions String?

  // Bank Details
  bankName      String?
  accountNumber String?
  accountName   String?
  swiftCode     String?

  // Mobile Money Details
  mobileMoneyProvider String?
  mobileMoneyNumber   String?
  mobileMoneyName     String?

  // Payment Gateway Configuration
  paystackEnabled        Boolean @default(false)
  paystackPublicKey      String?
  paystackSecretKey      String?
  flutterwaveEnabled     Boolean @default(false)
  flutterwavePublicKey   String?
  flutterwaveSecretKey   String?
  moniepointEnabled      Boolean @default(false)
  moniepointApiKey       String?
  moniepointContractCode String?

  // Settings (JSON)
  settings Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users                    User[]
  patients                 Patient[]
  appointments             Appointment[]
  consultations            Consultation[]
  prescriptions            Prescription[]
  labTests                 LabTest[]
  labParameters            LabParameter[]
  imagingTests             ImagingTest[]
  imagingResults           ImagingResult[]
  labOrders                LabOrder[]
  labTestRecords           LabTestRecord[]
  inventoryCategories      InventoryCategory[]
  medications              Medication[]
  medicationBatches        MedicationBatch[]
  dispensingRecords        DispensingRecord[]
  stockAlerts              StockAlert[]
  invoices                 Invoice[]
  payments                 Payment[]
  refunds                  Refund[]
  serviceCatalog           ServiceCatalog[]
  devices                  SyncDevice[]
  auditLogs                AuditLog[]
  paymentAuditLogs         PaymentAuditLog[]
  fraudPreventionSettings  FraudPreventionSettings?
  DrugInteraction          DrugInteraction[]
  Ward                     Ward[]
  Bed                      Bed[]
  Admission                Admission[]
  WardRound                WardRound[]
  MedicationAdministration MedicationAdministration[]
  VitalChart               VitalChart[]
  FluidChart               FluidChart[]
  TransfusionChart         TransfusionChart[]
  BloodSugarChart          BloodSugarChart[]
  AdmissionDiagnosis       AdmissionDiagnosis[]
  DischargeSummary         DischargeSummary[]
  BedTransferHistory       BedTransferHistory[]
  OperationNote            OperationNote[]
  Consumable               Consumable[]
  ConsumableBatch          ConsumableBatch[]
  ConsumableUsage          ConsumableUsage[]
  Notification             Notification[]
  DiagnosisCatalog         DiagnosisCatalog[]
  ConsultationDiagnosis    ConsultationDiagnosis[]
  Triage                   Triage[]
  PatientAllergy           PatientAllergy[]
  NextOfKin                NextOfKin[]
  insuranceProviders       InsuranceProvider[]
  patientInsurances        PatientInsurance[]
  insuranceClaims          InsuranceClaim[]
  exemptionPolicies        ExemptionPolicy[]
  LabResultValue           LabResultValue[]
  AncPregnancy             AncPregnancy[]
  AncVisit                 AncVisit[]
  PatientImmunization      PatientImmunization[]
  ImmunizationSchedule     ImmunizationSchedule[]
  LaborRecord              LaborRecord[]
  PartographObservation    PartographObservation[]
  SyncConflict             SyncConflict[]

  @@map("tenants")
}

// ==================== USER MANAGEMENT ====================

model User {
  id       String @id @default(uuid())
  tenantId String

  // Authentication
  email    String
  password String
  username String?

  // Personal Information
  firstName String
  lastName  String
  phone     String?

  // Role & Permissions
  role   UserRole
  status UserStatus @default(ACTIVE)

  // Security
  lastLogin             DateTime?
  failedLoginAttempts   Int       @default(0)
  lockedUntil           DateTime?
  requirePasswordChange Boolean   @default(true)
  passwordChangedAt     DateTime?
  passwordHistory       String[]  @default([])

  // Soft Delete
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant                 Tenant               @relation(fields: [tenantId], references: [id])
  consultations          Consultation[]
  prescriptions          Prescription[]
  labOrdersOrdered       LabOrder[]           @relation("OrderedBy")
  labTestRecordsReviewed LabTestRecord[]      @relation("ReviewedBy")
  dispensingRecords      DispensingRecord[]   @relation("PharmacistDispensing")
  appointments           Appointment[]
  invoices               Invoice[]
  payments               Payment[]
  paymentsApproved       Payment[]            @relation("PaymentApprovals")
  triageAssessments      Triage[]             @relation("TriageNurse")
  paymentsReconciled     Payment[]            @relation("PaymentReconciliations")
  imagingReports         ImagingResult[]      @relation("ImagingReporter")
  paymentsFlagged        Payment[]            @relation("PaymentFlags")
  paymentsReviewed       Payment[]            @relation("PaymentReviews")
  paymentAuditLogs       PaymentAuditLog[]
  refundsRequested       Refund[]             @relation("RefundRequester")
  refundsApproved        Refund[]             @relation("RefundApprover")
  refundsRejected        Refund[]             @relation("RefundRejecter")
  auditLogs              AuditLog[]
  passwordResetTokens    PasswordResetToken[]
  refreshTokens          RefreshToken[]
  sessions               Session[]

  admissionsAdmitted        Admission[]                @relation("AdmissionsAdmitted")
  wardRounds                WardRound[]                @relation("WardRoundsConducted")
  medAdministrations        MedicationAdministration[] @relation("MedAdministrations")
  vitalChartsRecorded       VitalChart[]               @relation("VitalChartsRecorded")
  fluidChartsRecorded       FluidChart[]               @relation("FluidChartsRecorded")
  transfusionChartsRecorded TransfusionChart[]         @relation("TransfusionChartsRecorded")
  bloodSugarChartsRecorded  BloodSugarChart[]          @relation("BloodSugarChartsRecorded")
  bedTransfers              BedTransferHistory[]       @relation("BedTransfers")
  operationNotesRecorded    OperationNote[]            @relation("OperationNotesRecorded")
  consumableUsageRecorded   ConsumableUsage[]          @relation("ConsumableUsageRecorded")
  notifications             Notification[]

  laborRecordsStarted            LaborRecord[]           @relation("LaborRecordsStarted")
  laborRecordsDelivered          LaborRecord[]           @relation("LaborRecordsDelivered")
  partographObservationsRecorded PartographObservation[] @relation("PartographObservationsRecorded")
  syncConflictsResolved          SyncConflict[]
  deletionReason            String?
  ancVisits                 AncVisit[]
  administeredImmunizations PatientImmunization[]

  @@unique([tenantId, email])
  @@map("users")
}

// ==================== PATIENT MANAGEMENT ====================

model Patient {
  id        String @id @default(uuid())
  tenantId  String
  patientId String // Format: PXXXXXXX

  // Demographics
  firstName     String
  lastName      String
  dateOfBirth   DateTime
  gender        Gender
  phone         String
  email         String?
  address       String?
  city          String?
  state         String?
  lga           String? // Local Government Area (Nigeria)
  country       String         @default("Nigeria")
  nationality   String?
  occupation    String?
  maritalStatus MaritalStatus?

  // Medical History
  bloodGroup          BloodGroup?
  genotype            Genotype? // AA, AS, SS, AC, etc.
  allergies           String[] // Legacy
  chronicConditions   String[] // Array of chronic conditions
  pastSurgicalHistory String? // Past surgeries and major medical procedures

  // Emergency Contact (stored as JSON)
  emergencyContact Json? // { name, relationship, phone, address }

  // NHIS & HMO
  patientType PatientType @default(PRIVATE)
  hmoProvider String?
  hmoNumber   String?
  nhisNumber  String?

  // Photo
  photoUrl String?

  // Consent & Privacy
  consentGiven   Boolean   @default(false)
  consentDate    DateTime?
  consentVersion String?

  // Status
  status    AlertStatus @default(ACTIVE)
  isDeleted Boolean     @default(false)
  deletedAt DateTime? // For soft deletes
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  // Optimistic concurrency — incremented on every update, checked by callers
  // that supply an expectedVersion (currently: the offline-sync push path).
  version Int @default(1)

  // Relations
  tenant         Tenant                @relation(fields: [tenantId], references: [id])
  appointments   Appointment[]
  consultations  Consultation[]
  prescriptions  Prescription[]
  labOrders      LabOrder[]
  invoices       Invoice[]
  payments       Payment[]
  refunds        Refund[]
  Admission      Admission[]
  Triage         Triage[]
  PatientAllergy PatientAllergy[]
  NextOfKin      NextOfKin[]
  insurances     PatientInsurance[]
  ancPregnancies AncPregnancy[]
  immunizations  PatientImmunization[]
  ImagingResult  ImagingResult[]
  laborRecords   LaborRecord[]
  consumableUsageRecords ConsumableUsage[]

  @@unique([tenantId, patientId])
  @@unique([tenantId, phone])
  @@index([tenantId, lastName, firstName])
  @@index([tenantId, status])
  // Trigram GIN indexes — the search repository does `contains`/ILIKE
  // matching on these four fields, which a plain btree index (above)
  // can't accelerate. Without these, every search is a sequential scan
  // that gets linearly worse as the patient table grows.
  @@index([firstName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([lastName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([patientId(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("patients")
}

// ==================== APPOINTMENT SCHEDULING ====================

model Appointment {
  id        String @id @default(uuid())
  tenantId  String
  patientId String
  doctorId  String

  // Appointment Details
  appointmentDate DateTime
  appointmentTime String
  appointmentType String
  reason          String?
  duration        Int      @default(30) // minutes

  // Status
  status             AppointmentStatus @default(SCHEDULED)
  checkedInAt        DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?

  // Reminders
  reminderSent24h Boolean   @default(false)
  reminderSent2h  Boolean   @default(false)
  // Soft Delete
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?
  deletedBy       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Optimistic concurrency — see Patient.version for the pattern.
  version Int @default(1)

  // Relations
  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])
  doctor  User    @relation(fields: [doctorId], references: [id])

  @@index([tenantId, appointmentDate, doctorId])
  @@map("appointments")
}

// ==================== CLINICAL DOCUMENTATION ====================

model Consultation {
  id        String @id @default(uuid())
  tenantId  String
  patientId String
  doctorId  String

  // SOAP Notes
  subjective String? // Chief complaint, history
  objective  String? // Physical examination findings
  assessment String? // Diagnosis, ICD-10 codes
  plan       String? // Treatment plan

  // Vital Signs
  bloodPressure String? // e.g., "120/80" (DEPRECATED)
  systolicBP    Int?
  diastolicBP   Int?
  heartRate     Int?
  temperature   Float?
  weight        Float?
  height        Float?
  spO2          Int? // Oxygen saturation
  bmi           Float? // Calculated

  // ICD-10 Codes
  icd10Codes String? // JSON array

  // Status
  status        ConsultationStatus @default(IN_PROGRESS)
  billingStatus BillingStatus      @default(UNBILLED)
  finalizedAt   DateTime?

  consultationDate DateTime  @default(now())
  // Soft Delete
  isDeleted        Boolean   @default(false)
  deletedAt        DateTime?
  deletedBy        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Optimistic concurrency — see Patient.version for the pattern.
  version Int @default(1)

  // Relations
  tenant           Tenant                  @relation(fields: [tenantId], references: [id])
  patient          Patient                 @relation(fields: [patientId], references: [id])
  doctor           User                    @relation(fields: [doctorId], references: [id])
  prescriptions    Prescription[]
  labOrders        LabOrder[]
  diagnoses        ConsultationDiagnosis[]
  ancVisit         AncVisit?
  invoiceLineItems InvoiceLineItem[]
  consumableUsageRecords ConsumableUsage[]

  @@index([tenantId, patientId])
  @@index([tenantId, consultationDate])
  @@map("consultations")
}

// ==================== E-PRESCRIBING ====================

model Prescription {
  id             String  @id @default(uuid())
  tenantId       String
  patientId      String
  consultationId String?
  doctorId       String
  type           String  @default("OUTPATIENT") // OUTPATIENT, INPATIENT, DISCHARGE

  // Prescription Details
  medicationId   String?
  medicationName String
  route          AdministrationRoute @default(ORAL)
  dosage         String
  frequency      String
  duration       String
  instructions   String?
  quantity       Int?
  quantityUnit   String?
  startDate      DateTime?
  endDate        DateTime?

  // Refills & Controlled Substances
  refillsAllowed         Int     @default(0)
  refillCount            Int     @default(0)
  originalPrescriptionId String?
  isControlledSubstance  Boolean @default(false)
  scheduleClass          String?

  // Dispensing
  dispensedAt DateTime?
  dispensedBy String?
  batchNumber String?
  expiryDate  DateTime?

  // Status
  status        PrescriptionStatus @default(PENDING)
  billingStatus BillingStatus      @default(UNBILLED)

  // Warnings
  allergyWarning     Boolean   @default(false)
  interactionWarning Boolean   @default(false)
  // Soft Delete
  isDeleted          Boolean   @default(false)
  deletedAt          DateTime?
  deletedBy          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Optimistic concurrency — see Patient.version for the pattern. No
  // general-purpose "edit prescription" endpoint exists today (only
  // workflow transitions like dispense/cancel, which are already guarded
  // by status checks) — this field exists for the sync entity map and
  // future use, not wired into a specific update path yet.
  version Int @default(1)

  // Relations
  tenant                   Tenant                     @relation(fields: [tenantId], references: [id])
  patient                  Patient                    @relation(fields: [patientId], references: [id])
  consultation             Consultation?              @relation(fields: [consultationId], references: [id])
  doctor                   User                       @relation(fields: [doctorId], references: [id])
  medication               Medication?                @relation(fields: [medicationId], references: [id])
  dispensingRecord         DispensingRecord?
  Admission                Admission?                 @relation(fields: [admissionId], references: [id])
  admissionId              String?
  ancVisit                 AncVisit?                  @relation(fields: [ancVisitId], references: [id])
  ancVisitId               String?
  MedicationAdministration MedicationAdministration[]
  deletionReason           String?
  invoiceLineItems         InvoiceLineItem[]

  @@index([tenantId, patientId])
  @@index([tenantId, status])
  @@index([tenantId, status, createdAt])
  @@map("prescriptions")
}

// ==================== LABORATORY ARCHITECTURE ====================

model LabTest {
  id        String  @id @default(cuid())
  tenantId  String
  name      String
  category  String // Hematology | Chemistry | Serology | Hormone | Microbiology | Imaging
  price     Int     @default(0) // in Naira, no decimals
  isActive  Boolean @default(true)
  loincCode String?

  parameters  LabTestParameter[]
  testRecords LabTestRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@map("lab_tests")
}

model LabParameter {
  id                   String  @id @default(cuid())
  tenantId             String
  name                 String
  unit                 String?
  refRangeMale         String?
  refRangeFemale       String?
  refRangeNotes        String? // free text for ranges that depend on age/phase/method
  needsClinicalReview  Boolean @default(false)
  loincCode            String?
  deltaCheckPercentage Float? // e.g., 20.0 means a 20% change triggers an alert

  tests           LabTestParameter[]
  resultValues    LabResultValue[]
  referenceRanges LabReferenceRange[]

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("lab_parameters")
}

model LabReferenceRange {
  id          String  @id @default(cuid())
  parameterId String
  minAgeDays  Int?
  maxAgeDays  Int?
  gender      String? // MALE, FEMALE, ANY
  minNumeric  Float?
  maxNumeric  Float?
  textRange   String?

  parameter LabParameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)

  @@map("lab_reference_ranges")
}

model LabTestParameter {
  testId       String
  parameterId  String
  displayOrder Int

  test      LabTest      @relation(fields: [testId], references: [id], onDelete: Cascade)
  parameter LabParameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)

  @@id([testId, parameterId])
  @@map("lab_test_parameters")
}

model ImagingTest {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  price    Int     @default(0)
  active   Boolean @default(true)

  results ImagingResult[]

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("imaging_tests")
}

model ImagingResult {
  id            String   @id @default(cuid())
  tenantId      String
  imagingTestId String
  patientId     String
  findings      String // free text
  images        String[] // file paths/URLs
  reportedBy    String
  reportedAt    DateTime @default(now())

  imagingTest ImagingTest @relation(fields: [imagingTestId], references: [id], onDelete: Cascade)
  patient     Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  reporter    User        @relation("ImagingReporter", fields: [reportedBy], references: [id])

  @@map("imaging_results")
}

model LabOrder {
  id             String  @id @default(uuid())
  tenantId       String
  patientId      String
  consultationId String?
  admissionId    String?
  orderedById    String

  orderNumber   String?     @unique
  urgency       TestUrgency @default(ROUTINE)
  clinicalNotes String?

  status        LabTestStatus @default(PENDING)
  billingStatus BillingStatus @default(UNBILLED)
  totalAmount   Int           @default(0) // snapshot of total cost in Naira

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  patient          Patient           @relation(fields: [patientId], references: [id])
  consultation     Consultation?     @relation(fields: [consultationId], references: [id])
  admission        Admission?        @relation(fields: [admissionId], references: [id])
  orderedBy        User              @relation("OrderedBy", fields: [orderedById], references: [id])
  testRecords      LabTestRecord[]
  invoiceLineItems InvoiceLineItem[]

  // Soft Delete
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  deletedBy      String?
  deletionReason String?

  @@index([tenantId, patientId])
  @@index([tenantId, status])
  @@map("lab_orders")
}

model LabTestRecord {
  id       String @id @default(uuid())
  tenantId String
  orderId  String
  testId   String

  accessionNumber String? @unique
  unitPrice       Int     @default(0) // snapshot of the test's price at order time

  // Specimen
  specimenType    String?
  specimenQuality String?
  collectedAt     DateTime?
  rejectionReason String?

  // Review & Approval
  reviewedById String?
  reviewedAt   DateTime?
  reviewNotes  String?

  // Status
  status LabTestStatus @default(PENDING)

  // Report
  reportUrl         String?
  reportGeneratedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  order        LabOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  test         LabTest          @relation(fields: [testId], references: [id])
  reviewedBy   User?            @relation("ReviewedBy", fields: [reviewedById], references: [id])
  resultValues LabResultValue[]

  // Soft Delete
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  deletedBy      String?
  deletionReason String?

  @@index([tenantId, orderId])
  @@index([tenantId, status])
  @@map("lab_test_records")
}

model LabResultValue {
  id           String @id @default(uuid())
  tenantId     String @default("3ffae4f7-d90b-4d2a-b67e-0f98d35fde70")
  testRecordId String
  parameterId  String

  numericValue Float?
  textValue    String?
  jsonValue    Json? // For complex microbiology / C&S results

  // Flags dynamically calculated
  isAbnormal Boolean @default(false)
  isCritical Boolean @default(false)
  flagType   String? // HIGH, LOW, CRITICAL_HIGH, CRITICAL_LOW, ABNORMAL

  // Delta Checks
  hasDeltaAlert   Boolean @default(false)
  deltaAlertNotes String?

  enteredAt DateTime @default(now())

  testRecord LabTestRecord @relation(fields: [testRecordId], references: [id], onDelete: Cascade)
  parameter  LabParameter  @relation(fields: [parameterId], references: [id])
  tenant     Tenant        @relation(fields: [tenantId], references: [id])

  @@unique([testRecordId, parameterId])
  @@index([tenantId])
  @@map("lab_result_values")
}

// ==================== PHARMACY MANAGEMENT ====================

// Backs ManageCategoriesModal.tsx / pharmacy.controller.ts's inventory
// category endpoints — those referenced `prisma.inventoryCategory` under
// @ts-ignore with no backing model, so every call to
// GET/POST/PUT/DELETE /api/pharmacy/categories threw at runtime.
model InventoryCategory {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@map("inventory_categories")
}

model Medication {
  id       String @id @default(uuid())
  tenantId String

  // Medication Details
  name             String
  genericName      String?
  brandName        String?
  activeIngredient String?
  category         String?
  dosageForm       String // Tablet, Capsule, Syrup, etc. — required so prescribing can rely on it
  strength         String // required so prescribing can rely on it
  drugClass        String?
  rxcui            String? // RxNorm Concept Unique Identifier

  // Inventory
  stockLevel   Int     @default(0)
  reorderPoint Int     @default(10)
  unitPrice    Decimal @db.Decimal(12, 2)

  // Phase 2 Controlled Substance
  isControlledSubstance Boolean @default(false)
  scheduleClass         String?

  // Status
  status    String    @default("AVAILABLE")
  // Soft Delete
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  batches        MedicationBatch[]
  stockAlerts    StockAlert[]
  prescriptions  Prescription[]
  deletionReason String?

  @@index([tenantId, name])
  @@index([tenantId, activeIngredient])
  @@index([tenantId, drugClass])
  @@map("medications")
}

model MedicationBatch {
  id           String @id @default(uuid())
  tenantId     String
  medicationId String

  // Batch Details
  batchNumber  String
  expiryDate   DateTime
  quantity     Int
  unitCost     Decimal  @db.Decimal(12, 2)
  sellingPrice Decimal  @db.Decimal(12, 2)

  // Supplier
  supplier     String?
  purchaseDate DateTime?

  // Status
  status    BatchStatus @default(ACTIVE)
  // Soft Delete
  isDeleted Boolean     @default(false)
  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant         Tenant             @relation(fields: [tenantId], references: [id])
  medication     Medication         @relation(fields: [medicationId], references: [id])
  dispensings    DispensingRecord[]
  stockAlerts    StockAlert[]
  deletionReason String?

  @@unique([tenantId, medicationId, batchNumber])
  @@index([tenantId, expiryDate])
  @@index([tenantId, medicationId, status])
  @@map("medication_batches")
}

model DispensingRecord {
  id             String @id @default(uuid())
  tenantId       String
  prescriptionId String @unique
  batchId        String
  pharmacistId   String

  // Dispensing Details
  quantityDispensed Int
  dispensedAt       DateTime @default(now())

  // Patient Instructions
  labelGenerated Boolean @default(false)
  labelUrl       String?

  // Notes
  pharmacistNotes String?
  // Soft Delete
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?
  deletedBy       String?

  createdAt DateTime @default(now())

  // Relations
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  prescription   Prescription    @relation(fields: [prescriptionId], references: [id])
  batch          MedicationBatch @relation(fields: [batchId], references: [id])
  pharmacist     User            @relation("PharmacistDispensing", fields: [pharmacistId], references: [id])
  deletionReason String?

  @@index([tenantId, dispensedAt])
  @@index([tenantId, pharmacistId])
  @@map("dispensing_records")
}

model DrugInteraction {
  id       String @id @default(uuid())
  tenantId String

  // Drug Names (generic or brand)
  drug1 String
  drug2 String

  // Interaction Details
  severity       AlertSeverity
  description    String
  clinicalEffect String?
  management     String?

  // Metadata
  source       String?
  lastVerified DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([drug1, drug2])
  @@index([drug1])
  @@index([drug2])
  @@index([tenantId])
  @@map("drug_interactions")
}

model StockAlert {
  id           String  @id @default(uuid())
  tenantId     String
  medicationId String
  batchId      String?

  // Alert Details
  alertType String
  severity  AlertSeverity
  message   String
  threshold Int?

  // Status
  status         AlertStatus @default(ACTIVE)
  acknowledgedBy String?
  acknowledgedAt DateTime?
  resolvedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  medication Medication       @relation(fields: [medicationId], references: [id])
  batch      MedicationBatch? @relation(fields: [batchId], references: [id])

  @@index([tenantId, status, alertType])
  @@index([tenantId, createdAt])
  @@map("stock_alerts")
}

// ==================== CONSUMABLES (non-drug supplies: syringes, gloves,
// gauze, cannula, etc. — stocked and billed like medications, but without
// dosage form/strength/drug-interaction concepts, and usage is a single
// step rather than a prescribe-then-dispense flow) ====================

model Consumable {
  id       String @id @default(uuid())
  tenantId String

  name        String
  category    String?
  unit        String  @default("piece") // piece, box, pack, roll, etc. — how it's counted
  description String?

  // Inventory
  stockLevel   Int     @default(0)
  reorderPoint Int     @default(10)
  unitPrice    Decimal @db.Decimal(12, 2)

  // Status
  status    String    @default("AVAILABLE")
  // Soft Delete
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  deletionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  batches      ConsumableBatch[]
  usageRecords ConsumableUsage[]

  @@index([tenantId, name])
  @@map("consumables")
}

model ConsumableBatch {
  id           String @id @default(uuid())
  tenantId     String
  consumableId String

  // Batch Details
  batchNumber String
  expiryDate  DateTime? // optional — some consumables (gloves, cotton wool) aren't tracked by expiry
  quantity    Int
  unitCost    Decimal  @db.Decimal(12, 2)
  sellingPrice Decimal @db.Decimal(12, 2)

  // Supplier
  supplier     String?
  purchaseDate DateTime?

  // Status
  status    BatchStatus @default(ACTIVE)
  // Soft Delete
  isDeleted Boolean     @default(false)
  deletedAt DateTime?
  deletedBy String?
  deletionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  consumable   Consumable        @relation(fields: [consumableId], references: [id])
  usageRecords ConsumableUsage[]

  @@unique([tenantId, consumableId, batchNumber])
  @@index([tenantId, expiryDate])
  @@index([tenantId, consumableId, status])
  @@map("consumable_batches")
}

// The billable record — this is the single-step "used N of these on this
// patient" action (no prescription/dispense pair like medications), which
// both deducts stock and creates an UNBILLED charge for invoice generation
// to pick up later, exactly like Prescription/LabOrder already do.
model ConsumableUsage {
  id           String @id @default(uuid())
  tenantId     String
  consumableId String
  batchId      String
  patientId    String
  recordedById String

  admissionId    String?
  consultationId String?

  quantityUsed Int
  notes        String?

  // Oxygen-therapy detail — populated only when the consumable's category is
  // "Oxygen" (or any future therapy needing the same shape, e.g. a
  // nebulizer treatment); null for ordinary consumables (gloves, syringes,
  // gauze, etc.). Explicit typed columns rather than a JSON blob so this
  // stays a real, indexable/queryable field.
  flowRateLpm    Float?  // Liters per minute
  deliveryMethod String? // "Nasal Cannula" | "Face Mask" | "Non-Rebreather Mask" | "CPAP/BiPAP"
  spO2Before     Int?    // SpO2 % immediately before starting
  spO2After      Int?    // SpO2 % after/during administration

  billingStatus BillingStatus @default(UNBILLED)

  usedAt DateTime @default(now())

  // Soft Delete
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  deletionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  consumable       Consumable        @relation(fields: [consumableId], references: [id])
  batch            ConsumableBatch   @relation(fields: [batchId], references: [id])
  patient          Patient           @relation(fields: [patientId], references: [id])
  recordedBy       User              @relation("ConsumableUsageRecorded", fields: [recordedById], references: [id])
  admission        Admission?        @relation(fields: [admissionId], references: [id])
  consultation     Consultation?     @relation(fields: [consultationId], references: [id])
  invoiceLineItems InvoiceLineItem[]

  @@index([tenantId, patientId])
  @@index([tenantId, billingStatus])
  @@map("consumable_usage")
}

// ==================== BILLING & PAYMENTS ====================

model Invoice {
  id         String @id @default(uuid())
  tenantId   String
  patientId  String
  issuedById String

  // Invoice Details
  invoiceNumber String
  invoiceDate   DateTime  @default(now())
  dueDate       DateTime?

  // Line Items
  items InvoiceLineItem[]

  // Amounts
  subtotal    Decimal @db.Decimal(12, 2)
  taxAmount   Decimal @default(0) @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  totalAmount Decimal @db.Decimal(12, 2)
  paidAmount  Decimal @default(0) @db.Decimal(12, 2)
  balance     Decimal @db.Decimal(12, 2)

  // Payment
  paymentStatus    PaymentStatus  @default(UNPAID)
  paymentMethod    PaymentMethod?
  paymentDate      DateTime?
  paymentReference String?

  // Status
  status InvoiceStatus @default(DRAFT)

  // Notes
  notes     String?
  // Soft Delete
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Optimistic concurrency — see Patient.version for the pattern.
  version Int @default(1)

  tenant    Tenant            @relation(fields: [tenantId], references: [id])
  patient   Patient           @relation(fields: [patientId], references: [id])
  issuedBy  User              @relation(fields: [issuedById], references: [id])
  payments  Payment[]
  refunds   Refund[]
  claim     InsuranceClaim?
  auditLogs InvoiceAuditLog[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, patientId])
  @@index([tenantId, status])
  @@index([tenantId, paymentStatus])
  @@map("invoices")
}

model InvoiceLineItem {
  id        String @id @default(uuid())
  invoiceId String

  serviceCode String
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  tax         Decimal @default(0) @db.Decimal(12, 2)
  subtotal    Decimal @db.Decimal(12, 2)

  insuranceCoverage  Decimal @default(0) @db.Decimal(12, 2)
  patientOutOfPocket Decimal @db.Decimal(12, 2)

  consultationId     String?
  prescriptionId     String?
  labOrderId         String?
  admissionId        String?
  consumableUsageId  String?
  transfusionChartId String?
  operationNoteId    String?
  laborRecordId      String?

  invoice         Invoice          @relation(fields: [invoiceId], references: [id])
  consultation    Consultation?    @relation(fields: [consultationId], references: [id], onDelete: Restrict)
  prescription    Prescription?    @relation(fields: [prescriptionId], references: [id], onDelete: Restrict)
  labOrder        LabOrder?        @relation(fields: [labOrderId], references: [id], onDelete: Restrict)
  admission       Admission?       @relation(fields: [admissionId], references: [id], onDelete: Restrict)
  consumableUsage ConsumableUsage? @relation(fields: [consumableUsageId], references: [id], onDelete: Restrict)
  transfusionChart TransfusionChart? @relation(fields: [transfusionChartId], references: [id], onDelete: Restrict)
  operationNote    OperationNote?    @relation(fields: [operationNoteId], references: [id], onDelete: Restrict)
  laborRecord      LaborRecord?      @relation(fields: [laborRecordId], references: [id], onDelete: Restrict)

  // Soft Delete
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  @@index([invoiceId])
  @@map("invoice_line_items")
}

model InvoiceAuditLog {
  id        String @id @default(uuid())
  tenantId  String
  invoiceId String
  userId    String
  action    String // e.g., CREATED, UPDATED, CANCELLED

  previousValues Json?
  newValues      Json?
  notes          String?

  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, invoiceId])
  @@index([tenantId, createdAt])
  @@map("invoice_audit_logs")
}

model InsuranceProvider {
  id           String                @id @default(uuid())
  tenantId     String
  name         String
  type         InsuranceProviderType
  contactPhone String?
  contactEmail String?
  address      String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant             @relation(fields: [tenantId], references: [id])
  policies PatientInsurance[]
  claims   InsuranceClaim[]

  @@index([tenantId, type])
  @@map("insurance_providers")
}

model PatientInsurance {
  id         String @id @default(uuid())
  tenantId   String
  patientId  String
  providerId String

  policyNumber    String
  groupNumber     String?
  planType        InsurancePlanType @default(STANDARD)
  copayPercentage Decimal           @default(0) @db.Decimal(5, 2)

  validFrom DateTime
  validTo   DateTime
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  patient  Patient           @relation(fields: [patientId], references: [id])
  provider InsuranceProvider @relation(fields: [providerId], references: [id])

  @@index([patientId, providerId])
  @@map("patient_insurance")
}

model InsuranceClaim {
  id          String @id @default(uuid())
  tenantId    String
  invoiceId   String @unique
  insuranceId String

  amountClaimed  Decimal     @db.Decimal(12, 2)
  amountApproved Decimal?    @db.Decimal(12, 2)
  status         ClaimStatus @default(DRAFT)

  submittedAt   DateTime?
  adjudicatedAt DateTime?
  denialReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  invoice  Invoice           @relation(fields: [invoiceId], references: [id])
  provider InsuranceProvider @relation(fields: [insuranceId], references: [id])

  @@index([tenantId, status])
  @@map("insurance_claims")
}

model ExemptionPolicy {
  id                 String                @id @default(uuid())
  tenantId           String
  name               String
  description        String?
  criteriaType       ExemptionCriteriaType
  criteriaValue      String // e.g. "<5", ">65", "PREGNANT"
  discountPercentage Decimal               @db.Decimal(5, 2) // e.g. 100 for free

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, isActive])
  @@map("exemption_policies")
}

model Payment {
  id            String @id @default(uuid())
  tenantId      String
  invoiceId     String
  patientId     String
  processedById String

  // Payment Details
  paymentNumber String // Format: PAY-YYYYMMDD-XXXX
  paymentDate   DateTime      @default(now())
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod

  // Payment Reference
  referenceNumber String? // Bank ref, card ref, etc.
  transactionId   String? // Flutterwave transaction ID

  // Card Payment Details (if applicable)
  cardLast4 String?
  cardBrand String? // Visa, Mastercard, etc.

  // Mobile Money Details (if applicable)
  mobileProvider String? // MTN, Airtel, etc.
  mobileNumber   String?

  // Status
  status PaymentProcessStatus @default(COMPLETED)

  // Payment Gateway Integration (Flexible for multiple processors)
  gatewayProvider String? // FLUTTERWAVE, PAYSTACK, STRIPE, INTERSWITCH, etc.
  gatewayRef      String? // Gateway transaction reference
  gatewayData     Json? // Store full gateway response
  gatewayStatus   String? // Gateway-specific status

  // Receipt
  receiptUrl     String?
  receiptPrinted Boolean @default(false)

  // FRAUD PREVENTION & AUDIT TRAIL
  // Proof of payment (especially for manual cash/bank transfer)
  receiptPhotoUrl  String? // Photo of physical receipt or bank slip
  proofDocumentUrl String? // Additional proof document

  // Verification & Approval (for fraud prevention)
  requiresApproval  Boolean   @default(false) // True if amount exceeds threshold
  approvedById      String? // Supervisor who approved the payment
  approvedAt        DateTime? // When it was approved
  verificationNotes String? // Notes from verifier/supervisor

  // Enhanced audit trail
  ipAddress    String? // IP address where payment was recorded
  userAgent    String? // Browser/device info
  deviceId     String? // Unique device identifier
  locationData Json? // GPS coordinates if available

  // Reconciliation tracking
  reconciledAt        DateTime? // When payment was reconciled with bank
  reconciledById      String? // Who reconciled it
  bankStatementRef    String? // Reference from bank statement
  reconciliationNotes String? // Notes during reconciliation

  // Flags for suspicious activity
  flaggedForReview Boolean   @default(false)
  flagReason       String? // Why it was flagged
  flaggedAt        DateTime?
  flaggedById      String?
  reviewedAt       DateTime?
  reviewedById     String?
  reviewNotes      String?

  // Notes
  notes     String?
  // Soft Delete
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Optimistic concurrency — see Patient.version for the pattern. No
  // general-purpose "edit payment" endpoint exists today (payments are
  // recorded once and reversed via Refund, not field-edited) — this field
  // exists for the sync entity map and future use, not wired into a
  // specific update path yet.
  version Int @default(1)

  // Relations
  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  invoice        Invoice           @relation(fields: [invoiceId], references: [id])
  patient        Patient           @relation(fields: [patientId], references: [id])
  processedBy    User              @relation(fields: [processedById], references: [id])
  approver       User?             @relation("PaymentApprovals", fields: [approvedById], references: [id])
  reconciler     User?             @relation("PaymentReconciliations", fields: [reconciledById], references: [id])
  flagger        User?             @relation("PaymentFlags", fields: [flaggedById], references: [id])
  reviewer       User?             @relation("PaymentReviews", fields: [reviewedById], references: [id])
  refunds        Refund[]
  auditLogs      PaymentAuditLog[]
  deletionReason String?

  @@unique([tenantId, paymentNumber])
  @@index([tenantId, invoiceId])
  @@index([tenantId, patientId])
  @@index([tenantId, paymentDate])
  @@index([tenantId, flaggedForReview])
  @@index([tenantId, requiresApproval])
  @@map("payments")
}

model Refund {
  id        String  @id @default(uuid())
  tenantId  String
  invoiceId String
  paymentId String?
  patientId String

  // Refund Details
  refundNumber String // Format: REF-YYYYMMDD-XXXX
  refundDate   DateTime @default(now())
  amount       Decimal  @db.Decimal(12, 2)
  reason       String

  // Approval Workflow
  requestedById   String
  requestedAt     DateTime  @default(now())
  approvedById    String?
  approvedAt      DateTime?
  rejectedById    String?
  rejectedAt      DateTime?
  rejectionReason String?

  status RefundStatus @default(PENDING)

  // Refund Method
  refundMethod    String
  referenceNumber String?

  // Notes
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Soft Delete
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  // Relations
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  payment     Payment? @relation(fields: [paymentId], references: [id])
  patient     Patient  @relation(fields: [patientId], references: [id])
  requestedBy User     @relation("RefundRequester", fields: [requestedById], references: [id])
  approvedBy  User?    @relation("RefundApprover", fields: [approvedById], references: [id])
  rejectedBy  User?    @relation("RefundRejecter", fields: [rejectedById], references: [id])

  @@unique([tenantId, refundNumber])
  @@index([tenantId, status])
  @@index([tenantId, invoiceId])
  @@map("refunds")
}

// FRAUD PREVENTION: Detailed audit log for all payment operations
model PaymentAuditLog {
  id        String             @id @default(uuid())
  tenantId  String
  paymentId String
  userId    String // Who performed the action
  action    PaymentAuditAction // CREATED, APPROVED, FLAGGED, RECONCILED, etc.

  // Details of the action
  previousValues Json? // State before the action
  newValues      Json? // State after the action
  changesSummary String? // Human-readable summary

  // Context
  ipAddress    String?
  userAgent    String?
  deviceId     String?
  locationData Json?

  // Additional metadata
  metadata Json? // Any additional context
  notes    String?

  createdAt DateTime @default(now())

  // Relations
  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([tenantId, paymentId])
  @@index([tenantId, userId])
  @@index([tenantId, action])
  @@index([tenantId, createdAt])
  @@map("payment_audit_logs")
}

// FRAUD PREVENTION: Configuration per tenant for fraud detection
model FraudPreventionSettings {
  id       String @id @default(uuid())
  tenantId String @unique

  // Approval thresholds
  cashApprovalThreshold         Float  @default(50000) // Amount requiring approval for cash
  bankTransferApprovalThreshold Float  @default(100000)
  mobileMoneyApprovalThreshold  Float  @default(75000)
  refundAutoApproveThreshold    Float? // Refund requests at or below this amount skip manual approval

  // Mandatory fields for manual payments
  requireReceiptPhotoForCash      Boolean @default(true)
  requireReferenceForBankTransfer Boolean @default(true)
  requireReferenceForMobileMoney  Boolean @default(true)

  // Duplicate detection settings
  duplicateDetectionEnabled       Boolean @default(true)
  duplicateTimeWindowMinutes      Int     @default(30) // Check for duplicates within this window
  duplicateAmountTolerancePercent Float   @default(0) // 0 means exact match

  // Backdating restrictions
  allowBackdating   Boolean @default(false)
  maxBackdatingDays Int     @default(0) // How many days back can payments be dated

  // Daily limits per user
  enableDailyLimits      Boolean @default(false)
  dailyCashLimitPerUser  Float?
  dailyTotalLimitPerUser Float?

  // Auto-flagging rules
  autoFlagLargeAmounts                Boolean @default(true)
  autoFlagAmountThreshold             Float   @default(200000)
  autoFlagMultiplePaymentsSameInvoice Boolean @default(true)
  autoFlagRoundAmounts                Boolean @default(false) // Flag suspiciously round amounts
  autoFlagOffHoursPayments            Boolean @default(false) // Flag payments outside business hours

  // Reconciliation requirements
  requireDailyReconciliation Boolean @default(true)
  reconciliationWindowDays   Int     @default(7) // Must reconcile within X days

  // Business hours for off-hours detection
  businessHoursStart String? @default("08:00") // HH:MM format
  businessHoursEnd   String? @default("18:00")

  // Notifications
  notifyAdminOnFlaggedPayment Boolean @default(true)
  notifyAdminOnLargePayment   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("fraud_prevention_settings")
}

model ServiceCatalog {
  id       String @id @default(uuid())
  tenantId String

  // Service Details
  serviceCode String
  serviceName String
  description String?
  category    ServiceCategory

  // Pricing
  basePrice Decimal @db.Decimal(12, 2)
  taxRate   Decimal @default(0) @db.Decimal(5, 2) // Percentage (e.g., 7.5 for 7.5%)

  // Status
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id])

  // Soft Delete
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  deletedBy      String?
  deletionReason String?

  @@unique([tenantId, serviceCode])
  @@index([tenantId, category])
  @@index([tenantId, isActive])
  @@map("service_catalog")
}

// ==================== DATA SYNCHRONIZATION ====================

model SyncDevice {
  id       String @id @default(uuid())
  tenantId String

  // Device Information — deviceId is tenant-scoped (not bare-unique): if a
  // deviceId were ever reused across two tenants, a bare-unique constraint
  // would let the second tenant's registration silently reassign that row's
  // tenantId, spuriously 403ing the first tenant's subsequent pushes. Not
  // practically reachable given crypto.randomUUID() entropy, but the
  // constraint should reflect the actual scoping regardless.
  deviceId   String
  deviceName String
  deviceType String // LAPTOP, DESKTOP, TABLET

  // Authentication
  deviceToken String @unique

  // Sync Status
  lastSyncAt     DateTime?
  syncStatus     String    @default("PENDING")
  pendingChanges Int       @default(0)

  // Device Info
  osVersion  String?
  appVersion String?

  // Status
  status DeviceStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  syncQueue     SyncQueue[]
  syncConflicts SyncConflict[]

  @@unique([tenantId, deviceId])
  @@map("sync_devices")
}

model SyncQueue {
  id       String @id @default(uuid())
  deviceId String

  // Sync Details
  entityType String // PATIENT, CONSULTATION, PRESCRIPTION, etc.
  entityId   String
  operation  SyncOperation
  priority   Int           @default(5) // 1 = highest, 10 = lowest

  // Data
  payload  String // JSON
  checksum String?

  // Status
  status        SyncStatus @default(PENDING)
  attempts      Int        @default(0)
  lastAttemptAt DateTime?
  errorMessage  String?

  // Conflict Resolution
  conflictDetected   Boolean @default(false)
  conflictResolution String?

  createdAt   DateTime  @default(now())
  processedAt DateTime?

  // Relations
  device    SyncDevice     @relation(fields: [deviceId], references: [id])
  conflicts SyncConflict[]

  @@index([deviceId, status])
  @@index([priority, createdAt])
  @@map("sync_queue")
}

model SyncConflict {
  id          String  @id @default(uuid())
  tenantId    String
  deviceId    String
  syncQueueId String?

  entityType String // Matches SyncQueue.entityType
  entityId   String

  // What the client had vs. what the server actually had at push time
  localPayload  Json
  serverPayload Json
  localVersion  Int
  serverVersion Int

  status     SyncConflictStatus @default(PENDING)
  resolution String? // e.g. KEEP_LOCAL, KEEP_SERVER, MERGED

  resolvedById String?
  resolvedAt   DateTime?

  createdAt DateTime @default(now())

  // Relations
  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  device     SyncDevice @relation(fields: [deviceId], references: [id])
  syncQueue  SyncQueue? @relation(fields: [syncQueueId], references: [id])
  resolvedBy User?      @relation(fields: [resolvedById], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, entityType, entityId])
  @@map("sync_conflicts")
}

// ==================== AUDIT & COMPLIANCE ====================

model AuditLog {
  id       String  @id @default(uuid())
  tenantId String
  userId   String?

  // Action Details
  action     String
  entityType String
  entityId   String?

  // Changes
  oldValues String? // JSON
  newValues String? // JSON

  // Context
  ipAddress String?
  userAgent String?

  // Metadata
  metadata String? // JSON

  timestamp DateTime @default(now())

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId, timestamp])
  @@index([tenantId, entityType, entityId])
  @@map("audit_logs")
}

// ==================== SYSTEM CONFIGURATION ====================

model SystemConfig {
  id       String           @id @default(uuid())
  key      String           @unique
  value    String // JSON
  category ServiceCategory?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_config")
}

// ==================== AUTHENTICATION & SECURITY ====================

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  // Session visibility (admin remediation Phase 5) — the separate `Session`
  // model exists in this schema but is never written to or read anywhere in
  // the app; RefreshToken is the one actually populated on every login, so
  // it's extended here rather than starting to dual-write to Session.
  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

