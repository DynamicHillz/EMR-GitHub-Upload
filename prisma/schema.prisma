// ==================== INPATIENT MANAGEMENT ====================

model Ward {
  id        String @id @default(uuid())
  tenantId  String
  name      String
  type      String // General, Private, ICU, Maternity, Pediatric, etc.
  capacity  Int
  dailyCost Float  @default(0) // Daily room cost for billing

  status String @default("ACTIVE") // ACTIVE, INACTIVE, MAINTENANCE

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  beds   Bed[]

  @@index([tenantId, type])
  @@map("wards")
}

model Bed {
  id             String  @id @default(uuid())
  tenantId       String
  wardId         String
  bedNumber      String
  type           String? // Standard, ICU, etc.
  isolationReady Boolean @default(false)

  status String @default("AVAILABLE") // AVAILABLE, OCCUPIED, MAINTENANCE

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant               @relation(fields: [tenantId], references: [id])
  ward          Ward                 @relation(fields: [wardId], references: [id])
  admissions    Admission[]
  transfersFrom BedTransferHistory[] @relation("TransferFromBed")
  transfersTo   BedTransferHistory[] @relation("TransferToBed")

  @@unique([wardId, bedNumber])
  @@map("beds")
}

model Admission {
  id           String @id @default(uuid())
  tenantId     String
  patientId    String
  bedId        String
  admittedById String

  admissionDate DateTime  @default(now())
  dischargeDate DateTime?
  reason        String
  status        String    @default("ADMITTED") // ADMITTED, DISCHARGED, TRANSFERRED
  billingStatus String    @default("UNBILLED") // UNBILLED, BILLED

  // Drives which clinical tabs show on the inpatient details page (Operation
  // Note / Partograph) — see the two override flags below for the "medical
  // admission that turns into a surgery mid-stay" case.
  admissionType String @default("MEDICAL") // MEDICAL, SURGERY, CHILD_BIRTH

  // Manual overrides so a tab can be turned on even when admissionType alone
  // wouldn't show it (e.g. a MEDICAL admission where surgery becomes
  // necessary partway through the stay) — editable any time, not just at
  // admission.
  showOperationNote Boolean @default(false)
  showPartograph    Boolean @default(false)

  // Manual override for the "Record Oxygen" quick action on the inpatient
  // details page — off by default since most admissions never need it;
  // turned on per-admission (any admissionType) when actually needed rather
  // than shown unconditionally for every patient.
  showOxygen Boolean @default(false)

  isolationRequired Boolean @default(false)
  infectionRisk     String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant  @relation(fields: [tenantId], references: [id])
  patient    Patient @relation(fields: [patientId], references: [id])
  bed        Bed     @relation(fields: [bedId], references: [id])
  admittedBy User    @relation("AdmissionsAdmitted", fields: [admittedById], references: [id])

  wardRounds                WardRound[]
  medicationAdministrations MedicationAdministration[]
  prescriptions             Prescription[]
  labOrders                 LabOrder[]
  vitalCharts               VitalChart[]
  fluidCharts               FluidChart[]
  transfusionCharts         TransfusionChart[]
  bloodSugarCharts          BloodSugarChart[]
  diagnoses                 AdmissionDiagnosis[]
  dischargeSummary          DischargeSummary?
  transferHistory           BedTransferHistory[]
  operationNotes            OperationNote[]
  consumableUsageRecords    ConsumableUsage[]
  laborRecord               LaborRecord?
  invoiceLineItems          InvoiceLineItem[]

  // Soft Delete
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  deletedBy      String?
  deletionReason String?

  @@index([tenantId, patientId])
  @@index([tenantId, status])
  @@map("admissions")
}

model WardRound {
  id            String @id @default(uuid())
  tenantId      String
  admissionId   String
  conductedById String

  roundDate DateTime @default(now())
  notes     String // Clinical notes
  vitals    Json? // BP, HR, Temp, etc.
  plan      String? // Plan for the day

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  admission   Admission @relation(fields: [admissionId], references: [id])
  conductedBy User      @relation("WardRoundsConducted", fields: [conductedById], references: [id])

  // Soft Delete
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  deletedBy      String?
  deletionReason String?

  @@index([tenantId, admissionId])
  @@map("ward_rounds")
}

model MedicationAdministration {
  id               String  @id @default(uuid())
  tenantId         String
  admissionId      String
  prescriptionId   String?
  administeredById String

  medicationName String
  dosage         String
  route          String?
  administeredAt DateTime @default(now())
  notes          String?
  omissionReason String?
  status         String   @default("COMPLETED") // COMPLETED, MISSED, REFUSED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  admission      Admission     @relation(fields: [admissionId], references: [id])
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id])
  administeredBy User          @relation("MedAdministrations", fields: [administeredById], references: [id])

  @@index([tenantId, admissionId])
  @@map("medication_administrations")
}

model VitalChart {
  id           String @id @default(uuid())
  tenantId     String
  admissionId  String
  recordedById String

  recordedAt      DateTime @default(now())
  temperature     Float?
  systolicBP      Int?
  diastolicBP     Int?
  heartRate       Int?
  respiratoryRate Int?
  spO2            Int?
  painScore       Int? // 0-10 scale

  // Anthropometry
  weight            Float?
  height            Float?
  headCircumference Float?
  muac              Float?
  bmi               Float?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  admission  Admission @relation(fields: [admissionId], references: [id])
  recordedBy User      @relation("VitalChartsRecorded", fields: [recordedById], references: [id])

  // Soft Delete
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  deletedBy      String?
  deletionReason String?

  @@index([tenantId, admissionId])
  @@index([tenantId, recordedAt])
  @@map("vital_charts")
}

model FluidChart {
  id           String @id @default(uuid())
  tenantId     String
  admissionId  String
  recordedById String

  recordedAt DateTime  @default(now())
  type       FluidType // INTAKE, OUTPUT
  route      String // Oral, IV, Urine, Vomitus, etc.
  fluidName  String? // e.g., Normal Saline, Water
  volumeMl   Float

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  admission  Admission @relation(fields: [admissionId], references: [id])
  recordedBy User      @relation("FluidChartsRecorded", fields: [recordedById], references: [id])

  // Soft Delete
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  deletedBy      String?
  deletionReason String?

  @@index([tenantId, admissionId])
  @@index([tenantId, recordedAt])
  @@map("fluid_charts")
}

model TransfusionChart {
  id             String @id @default(uuid())
  tenantId       String
  admissionId    String
  transfusedById String

  bloodGroup  String
  unitNumber  String
  productType String // PRBC, Whole Blood, Platelets, FFP

  startTime DateTime
  endTime   DateTime?

  preVitals    Json? // JSON object with baseline vitals
  duringVitals Json? // Array of JSON objects for 15-min checks
  postVitals   Json? // JSON object for completion vitals

  reaction      Boolean @default(false)
  reactionNotes String?

  billingStatus BillingStatus @default(UNBILLED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  admission        Admission         @relation(fields: [admissionId], references: [id])
  transfusedBy     User              @relation("TransfusionChartsRecorded", fields: [transfusedById], references: [id])
  invoiceLineItems InvoiceLineItem[]

  // Soft Delete
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  deletedBy      String?
  deletionReason String?

  @@index([tenantId, admissionId])
  @@map("transfusion_charts")
}

model BloodSugarChart {
  id           String @id @default(uuid())
  tenantId     String
  admissionId  String
  recordedById String

  recordedAt         DateTime @default(now())
  bloodGlucose       Float
  unit               String   @default("mg/dL") // mg/dL or mmol/L
  measurementContext String? // Fasting, Post-prandial, Random

  insulinGiven String? // e.g., "10 units Actrapid"
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  admission  Admission @relation(fields: [admissionId], references: [id])
  recordedBy User      @relation("BloodSugarChartsRecorded", fields: [recordedById], references: [id])

  // Soft Delete
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  deletedBy      String?
  deletionReason String?

  @@index([tenantId, admissionId])
  @@index([tenantId, recordedAt])
  @@map("blood_sugar_charts")
}

model AdmissionDiagnosis {
  id          String  @id @default(uuid())
  tenantId    String
  admissionId String
  diagnosisId String
  isPrimary   Boolean @default(false)
  isAdmission Boolean @default(true) // true = Admission, false = Discharge
  notes       String?

  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  admission Admission        @relation(fields: [admissionId], references: [id])
  diagnosis DiagnosisCatalog @relation(fields: [diagnosisId], references: [id])

  createdAt DateTime @default(now())

  @@index([tenantId, admissionId])
  @@map("admission_diagnoses")
}

model DischargeSummary {
  id             String  @id @default(uuid())
  tenantId       String
  admissionId    String  @unique
  finalNotes     String
  followUpPlan   String?
  ttoMedications Json? // To Take Out medications

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  admission Admission @relation(fields: [admissionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Soft Delete
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  deletedBy      String?
  deletionReason String?

  @@index([tenantId])
  @@map("discharge_summaries")
}

model BedTransferHistory {
  id              String @id @default(uuid())
  tenantId        String
  admissionId     String
  fromBedId       String
  toBedId         String
  transferredById String

  transferDate DateTime @default(now())
  reason       String

  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  admission     Admission @relation(fields: [admissionId], references: [id])
  fromBed       Bed       @relation("TransferFromBed", fields: [fromBedId], references: [id])
  toBed         Bed       @relation("TransferToBed", fields: [toBedId], references: [id])
  transferredBy User      @relation("BedTransfers", fields: [transferredById], references: [id])

  @@index([tenantId, admissionId])
  @@map("bed_transfer_history")
}

model OperationNote {
  id           String @id @default(uuid())
  tenantId     String
  admissionId  String
  recordedById String

  surgicalProcedure String
  indication        String?
  surgeons          String // free text, e.g. "Dr. A, Dr. B" — may include staff not in the system
  assistants        String?
  anaesthetics      String?
  anaesthetist      String?
  anaesthesis       String?
  incision          String?
  findings          String?
  procedure         String?
  // Postop plan, folded into this same record so operation note and postop
  // plan are recorded together as a single form (the standalone PostopPlan
  // model has been retired — see below).
  plan              String?
  others            String?

  operationDate DateTime @default(now())

  billingStatus BillingStatus @default(UNBILLED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  admission        Admission         @relation(fields: [admissionId], references: [id])
  recordedBy       User              @relation("OperationNotesRecorded", fields: [recordedById], references: [id])
  invoiceLineItems InvoiceLineItem[]

  // Soft Delete
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  deletedBy      String?
  deletionReason String?

  @@index([tenantId, admissionId])
  @@map("operation_notes")
}

model Notification {
  id         String    @id @default(uuid())
  tenantId   String
  userId     String
  type       String // CRITICAL_LAB_RESULT | STOCK_ALERT
  title      String
  message    String
  entityType String?
  entityId   String?
  isRead     Boolean   @default(false)
  readAt     DateTime?

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId, userId, isRead])
  @@map("notifications")
}

model DiagnosisCatalog {
  id          String  @id @default(uuid())
  tenantId    String
  code        String // e.g., 'A00', '1B00'
  name        String
  description String?
  type        String  @default("ICD-11") // ICD-10 or ICD-11
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant             Tenant                  @relation(fields: [tenantId], references: [id])
  consultations      ConsultationDiagnosis[]
  admissionDiagnoses AdmissionDiagnosis[]

  @@unique([tenantId, code])
  @@index([name])
  @@index([code])
  @@map("diagnosis_catalog")
}

enum FluidType {
  INTAKE
  OUTPUT
}

model ConsultationDiagnosis {
  id             String @id @default(uuid())
  tenantId       String
  consultationId String
  diagnosisId    String

  isPrimary Boolean            @default(false)
  certainty DiagnosisCertainty @default(PROVISIONAL)
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  consultation Consultation     @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  diagnosis    DiagnosisCatalog @relation(fields: [diagnosisId], references: [id])

  @@unique([consultationId, diagnosisId])
  @@map("consultation_diagnoses")
}

// ==================== PHASE 2 MODELS ====================

model Triage {
  id            String  @id @default(uuid())
  tenantId      String
  patientId     String
  appointmentId String?

  // WHO ETAT Assessment
  chiefComplaint String
  category       TriageCategory
  triageNurseId  String
  triageTime     DateTime       @default(now())

  // Vitals at triage
  systolicBP         Int?
  diastolicBP        Int?
  heartRate          Int?
  temperature        Float?
  respiratoryRate    Int?
  spO2               Int?
  weight             Float?
  painScore          Int? // 0-10
  glucoseLevel       Float?
  consciousnessLevel String? // AVPU: Alert, Voice, Pain, Unresponsive

  // Pediatric specifics
  muac         Float?
  isDehydrated Boolean?

  // Disposition
  dispositionNotes   String?
  seenByDoctorAt     DateTime?
  waitingTimeMinutes Int?

  // Re-triage
  retriagedAt      DateTime?
  retriagedById    String?
  previousCategory TriageCategory?

  // Optimistic-concurrency token — two nurses editing the same triage
  // record concurrently otherwise silently last-write-wins with no conflict
  // detection at all (unlike Patient/Consultation/Invoice).
  version Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant      Tenant  @relation(fields: [tenantId], references: [id])
  patient     Patient @relation(fields: [patientId], references: [id])
  triageNurse User    @relation("TriageNurse", fields: [triageNurseId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, category])
  @@map("triage_assessments")
}

model PatientAllergy {
  id           String    @id @default(uuid())
  tenantId     String
  patientId    String
  allergen     String
  reactionType String // Anaphylaxis, Rash, GI distress, etc.
  severity     String // MILD, MODERATE, SEVERE, LIFE_THREATENING
  onsetDate    DateTime?
  isVerified   Boolean   @default(false)
  verifiedById String?
  notes        String?
  createdAt    DateTime  @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])

  // Soft Delete
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  deletedBy      String?
  deletionReason String?

  @@index([tenantId, patientId])
  @@map("patient_allergies")
}

model NextOfKin {
  id           String  @id @default(uuid())
  tenantId     String
  patientId    String
  fullName     String
  relationship String // SPOUSE, PARENT, SIBLING, CHILD, OTHER
  phoneNumber  String
  altPhone     String?
  address      String?
  priority     Int     @default(1) // 1 = primary, 2 = secondary, etc.

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])

  // Soft Delete
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  deletedBy      String?
  deletionReason String?

  @@unique([tenantId, patientId, priority])
  @@index([tenantId, patientId])
  @@map("next_of_kin")
}

// ==================== MATERNAL & CHILD HEALTH (ANC) ====================

model AncPregnancy {
  id        String @id @default(uuid())
  tenantId  String
  patientId String

  // Pregnancy Details (Current)
  gravidity         Int // Total number of pregnancies
  parity            Int // Number of viable births
  lmp               DateTime? // Last Menstrual Period
  edd               DateTime? // Expected Date of Delivery
  bloodGroup        BloodGroup?
  husbandBloodGroup String?

  // Obstetric History (Complications & Outcomes)
  livingChildren        Int     @default(0)
  abortionsMiscarriages Int     @default(0)
  historyOfCSection     Boolean @default(false)
  historyOfPPH          Boolean @default(false)
  historyOfPreEclampsia Boolean @default(false)
  historyOfStillbirth   Boolean @default(false)

  // Medical Risk Profiling
  preExistingDiabetes     Boolean @default(false)
  preExistingHypertension Boolean @default(false)
  cardiacDisease          Boolean @default(false)
  multipleGestation       Boolean @default(false)

  // Status
  isActive     Boolean   @default(true)
  deliveryDate DateTime?
  outcome      String? // LIVE_BIRTH, STILLBIRTH, MISCARRIAGE, etc.

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  patient      Patient       @relation(fields: [patientId], references: [id])
  visits       AncVisit[]
  laborRecords LaborRecord[]

  @@index([tenantId, patientId])
  @@index([tenantId, isActive])
  @@map("anc_pregnancies")
}

model AncVisit {
  id             String  @id @default(uuid())
  tenantId       String
  pregnancyId    String
  consultationId String? @unique
  recordedById   String

  // Vitals & Metrics
  gestationalAgeWeeks Int?
  weight              Float?
  systolicBP          Int?
  diastolicBP         Int?
  fundalHeight        Float? // in cm
  fetalHeartRate      Int?
  presentation        String? // CEPHALIC, BREECH, etc.
  urineProtein        String? // NEGATIVE, TRACE, 1+, 2+, 3+

  // WHO Standard programmatic fields
  ironFolicAcidProvided Boolean @default(false)
  calciumProvided       Boolean @default(false)
  itnProvided           Boolean @default(false)
  iptpDose              Int? // 1, 2, 3, etc.
  ttDosesToDate         Int? // Cumulative Tetanus Toxoid doses
  ttDoseGivenToday      Boolean @default(false)

  // Disease Screening
  syphilisTestResult String? // POSITIVE, NEGATIVE, UNKNOWN
  hivTestResult      String?
  hepBTestResult     String?
  malariaRdtResult   String?

  // Scans & Counseling
  ultrasoundDone                   Boolean @default(false)
  counselingDone                   Boolean @default(false)
  counseledOnDangerSigns           Boolean @default(false)
  birthPreparednessPlanDiscussed   Boolean @default(false)
  intimatePartnerViolenceScreening Boolean @default(false)

  // Deworming
  dewormingProvided Boolean @default(false)

  // Notes
  notes  String?
  others String?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  pregnancy    AncPregnancy   @relation(fields: [pregnancyId], references: [id], onDelete: Cascade)
  consultation Consultation?  @relation(fields: [consultationId], references: [id])
  recordedBy   User           @relation(fields: [recordedById], references: [id])
  prescriptions Prescription[]

  @@index([tenantId, pregnancyId])
  @@map("anc_visits")
}

// ==================== LABOR & PARTOGRAPH ====================

enum LaborStatus {
  IN_LABOR
  DELIVERED
  TRANSFERRED
  DISCONTINUED
}

model LaborRecord {
  id          String @id @default(uuid())
  tenantId    String
  admissionId String @unique
  patientId   String
  pregnancyId String? // nullable — walk-in delivery may have no ANC record on file
  startedById String

  // Labor onset / active-phase / rupture-of-membranes tracking
  laborOnsetAt       DateTime
  onsetType          String? // SPONTANEOUS, INDUCED, AUGMENTED
  activePhaseOnsetAt DateTime? // stamped on first observation with cervicalDilation >= 4cm
  romAt              DateTime?
  romType            String? // SPONTANEOUS, ARTIFICIAL
  liquorAtRom        String? // CLEAR, MECONIUM_STAINED, BLOOD_STAINED

  status LaborStatus @default(IN_LABOR)

  // Delivery Outcome — folded flat onto this model rather than a separate
  // child model, matching DischargeSummary's flat-fields convention.
  deliveredAt           DateTime?
  deliveredById         String?
  modeOfDelivery        String? // SVD, ASSISTED_VACUUM, ASSISTED_FORCEPS, CESAREAN_SECTION, BREECH
  perineumStatus        String? // INTACT, EPISIOTOMY, FIRST_DEGREE_TEAR, SECOND_DEGREE_TEAR, THIRD_DEGREE_TEAR, FOURTH_DEGREE_TEAR
  estimatedBloodLossMl  Int?
  babyOutcome           String? // LIVE_BIRTH, STILLBIRTH_FRESH, STILLBIRTH_MACERATED
  babySex               Gender?
  babyBirthWeightGrams  Int?
  apgarScore1Min        Int?
  apgarScore5Min        Int?
  resuscitationRequired Boolean @default(false)
  deliveryNotes         String?

  billingStatus BillingStatus @default(UNBILLED)

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant           Tenant                   @relation(fields: [tenantId], references: [id])
  admission        Admission                @relation(fields: [admissionId], references: [id])
  patient          Patient                  @relation(fields: [patientId], references: [id])
  pregnancy        AncPregnancy?            @relation(fields: [pregnancyId], references: [id])
  startedBy        User                     @relation("LaborRecordsStarted", fields: [startedById], references: [id])
  deliveredBy      User?                    @relation("LaborRecordsDelivered", fields: [deliveredById], references: [id])
  observations     PartographObservation[]
  invoiceLineItems InvoiceLineItem[]

  // Soft Delete
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  deletedBy      String?
  deletionReason String?

  @@index([tenantId, status])
  @@index([tenantId, patientId])
  @@map("labor_records")
}

model PartographObservation {
  id            String @id @default(uuid())
  tenantId      String
  laborRecordId String
  recordedById  String

  recordedAt DateTime @default(now())

  // Charted (Dilation Chart)
  cervicalDilation Int? // cm, 0-10

  // Charted (Fetal Heart Rate Chart)
  fetalHeartRate Int? // bpm

  // Structured entry — tabular only, not charted (first-cut scope decision)
  descentOfHead                 String? // station notation, e.g. "3/5" or "-2"
  liquor                        String? // CLEAR, MECONIUM_LIGHT, MECONIUM_THICK, BLOOD_STAINED, ABSENT
  moulding                      String? // 0, +1, +2, +3
  contractionsFrequencyPer10Min Int?
  contractionsDurationSeconds   Int?
  maternalPulse                 Int?
  maternalSystolicBP            Int?
  maternalDiastolicBP           Int?
  maternalTemperature           Float?
  urineProtein                  String? // NEGATIVE, TRACE, 1+, 2+, 3+
  urineAcetone                  String? // NEGATIVE, TRACE, 1+, 2+, 3+
  urineVolumeMl                 Int?
  oxytocinDose                  String? // free text — dosing units vary by protocol
  drugsGiven                    String?
  ivFluids                      String?
  notes                         String?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  laborRecord LaborRecord @relation(fields: [laborRecordId], references: [id])
  recordedBy  User        @relation("PartographObservationsRecorded", fields: [recordedById], references: [id])

  // Soft Delete
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  deletedBy      String?
  deletionReason String?

  @@index([tenantId, laborRecordId])
  @@index([tenantId, recordedAt])
  @@map("partograph_observations")
}

// ==================== IMMUNIZATION ====================

model ImmunizationSchedule {
  id       String @id @default(uuid())
  tenantId String

  // Vaccine Details
  vaccineName    String // e.g., "BCG", "OPV 1", "Pentavalent 1"
  diseaseTarget  String // e.g., "Tuberculosis", "Polio"
  targetAgeWeeks Int // Standard WHO timeline (0 = birth, 6 = 6 weeks, etc.)
  route          String? // ORAL, IM, SUB-Q
  description    String?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant       Tenant                @relation(fields: [tenantId], references: [id])
  administered PatientImmunization[]

  @@unique([tenantId, vaccineName])
  @@map("immunization_schedule")
}

model PatientImmunization {
  id               String @id @default(uuid())
  tenantId         String
  patientId        String
  scheduleId       String
  administeredById String

  // Administration Details
  administeredAt     DateTime  @default(now())
  batchNumber        String?
  nextDueDate        DateTime? // For multi-dose series
  notes              String?
  hasAdverseReaction Boolean   @default(false)
  reactionNotes      String?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant         Tenant               @relation(fields: [tenantId], references: [id])
  patient        Patient              @relation(fields: [patientId], references: [id])
  schedule       ImmunizationSchedule @relation(fields: [scheduleId], references: [id])
  administeredBy User                 @relation(fields: [administeredById], references: [id])

  @@unique([patientId, scheduleId])
  @@index([tenantId, patientId])
  @@map("patient_immunizations")
}
