{
  "name": "ssmc-emr",
  "version": "1.0.0",
  "description": "St. Stephen Medical Centre - Offline-capable Electronic Medical Records system",
  "scripts": {
    "dev:backend": "nodemon src/backend/server.ts",
    "dev:frontend": "vite",
    "build:backend": "tsc -p tsconfig.backend.json",
    "build:frontend": "vite build",
    "build:all": "npm run build:backend && npm run build:frontend",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:seed": "ts-node src/backend/prisma/seed.ts",
    "db:check": "ts-node src/backend/scripts/check-db-connection.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:verbose": "jest --verbose",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\""
  },
  "keywords": [
    "emr",
    "electronic-medical-records",
    "healthcare",
    "offline-first",
    "clinic-management"
  ],
  "author": "SSMC EMR Team",
  "license": "PROPRIETARY",
  "dependencies": {
    "@prisma/client": "^5.7.0",
    "@sentry/node": "^10.68.0",
    "@sentry/react": "^10.68.0",
    "@types/multer": "^2.2.0",
    "axios": "^1.18.1",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.0.0",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "idb": "^8.0.3",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.300.0",
    "multer": "^2.2.0",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-big-calendar": "^1.19.4",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.49.2",
    "react-query": "^3.39.3",
    "react-router-dom": "^6.20.1",
    "recharts": "^3.9.2",
    "serve": "^14.2.6",
    "serve-handler": "^6.1.7",
    "tailwind-merge": "^2.2.0",
    "uuid": "^9.0.1",
    "vite-plugin-pwa": "^1.3.0",
    "winston": "^3.11.0",
    "zod": "^3.22.4",
    "zustand": "^4.4.7"
