{
  "name": "ssmc-emr",
  "version": "1.0.0",
  "description": "St. Stephen Medical Centre - Offline-capable Electronic Medical Records system",
  "main": "electron-main-simple.js",
  "scripts": {
    "dev:backend": "nodemon src/backend/server.ts",
    "dev:frontend": "vite",
    "dev:electron": "npm run build:electron:main && electron .",
    "dev:electron:watch": "nodemon --watch src/electron --ext ts --exec \"npm run build:electron:main && electron .\"",
    "build:backend": "tsc -p tsconfig.backend.json",
    "build:frontend": "vite build",
    "build:electron:main": "tsc -p tsconfig.electron.json",
    "build:electron": "npm run build:electron:main && electron-builder",
    "build:all": "npm run build:backend && npm run build:frontend && npm run build:electron:main",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:seed": "ts-node src/backend/prisma/seed.ts",
    "db:check": "ts-node src/backend/scripts/check-db-connection.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:verbose": "jest --verbose",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\""
  },
  "keywords": [
    "emr",
    "electronic-medical-records",
    "healthcare",
    "offline-first",
    "electron",
    "clinic-management"
  ],
  "author": "SSMC EMR Team",
  "license": "PROPRIETARY",
  "dependencies": {
    "@journeyapps/sqlcipher": "^5.3.1",
    "@prisma/client": "^5.7.0",
    "axios": "^1.6.2",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "clsx": "^2.0.0",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.300.0",
    "pg": "^8.16.3",
    "react": "^18.2.0",
    "react-big-calendar": "^1.19.4",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.49.2",
    "react-query": "^3.39.3",
    "react-router-dom": "^6.20.1",
    "tailwind-merge": "^2.2.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.46",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^18.2.18",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "postcss": "^8.4.32",
    "prettier": "^3.1.1",
    "prisma": "^5.7.0",
    "tailwindcss": "^3.4.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vite": "^5.0.10"
  },
  "build": {
    "appId": "com.ssmc.emr",
    "productName": "SSMC EMR",
    "copyright": "Copyright 2025 SSMC EMR Team",
    "icon": "assets/icon.png",
    "asar": false,
    "afterPack": "./after-pack.js",
    "directories": {
      "output": "dist-electron",
      "buildResources": "assets"
    },
    "files": [
      "electron-main-simple.js",
      "dist/**/*",
      "assets/**/*",
      "package.json",
      ".env",
      "node_modules",
      "node_modules/.prisma/**/*",
      "!node_modules/electron",
      "!node_modules/electron-builder",
      "!node_modules/typescript",
      "!node_modules/vite",
      "!node_modules/@vitejs",
      "!node_modules/eslint",
      "!node_modules/@typescript-eslint",
      "!node_modules/prettier",
      "!node_modules/jest",
      "!node_modules/@jest",
      "!node_modules/ts-jest",
      "!node_modules/ts-node",
      "!node_modules/@types",
      "!node_modules/nodemon",
      "!node_modules/prisma",
      "!node_modules/autoprefixer",
      "!node_modules/postcss",
      "!node_modules/tailwindcss",
      "!node_modules/@babel",
      "!node_modules/@react-refresh"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": "x64"
        },
        {
          "target": "zip",
          "arch": "x64"
        }
      ],
      "icon": "assets/icon.png",
      "sign": false,
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SSMC EMR"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  }
}
