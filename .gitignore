.aider*

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.production

# Build outputs
dist/
dist-electron/
build/

# Logs
logs/
*.log

# Database
*.db
*.db-journal
*.sqlite
*.sqlite3

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Prisma
src/backend/generated/

# Testing
coverage/

# Temporary files
*.tmp
temp/

# User-uploaded files (clinic logos, etc.) — machine-specific storage
uploads/

# Test scripts
test_*.js
insert_test*.js
check_*.js
delete_*.js
list_*.js
exact_search.js
fix_admin.js
hard_delete_*.js
query.js
