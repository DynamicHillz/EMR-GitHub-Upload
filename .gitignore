# --- Add these lines to your existing .gitignore ---
 
# One-off scripts containing plaintext passwords/secrets — never commit
generate-hash.js
*-hash.js
 
# PM2 runtime state — machine-specific, never share between PCs
.pm2/

# Database backups (pg_dump output) — machine-specific, contains patient data
backups/

# TLS cert/key generated locally via mkcert — machine-specific, private key
certs/
