{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "./dist/backend",
    "rootDir": "./src/backend",
    "noEmit": false,
    "lib": ["ES2020"],
    "allowImportingTsExtensions": false
  },
  "include": ["src/backend/**/*", "src/backend/types/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/frontend",
    "src/electron",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/__tests__/**/*"
  ]
}
